# OpenAI (for summarization)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Output channels
# Set false to run email-only without X credentials
X_ENABLED=true
EMAIL_ENABLED=false

# X API credentials
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Bot behavior
# Set to true for testing without posting to X or sending live email
DRY_RUN=true
# Number of posts per run
MAX_POSTS_PER_RUN=3
# Hours between runs (scheduler)
RUN_EVERY_HOURS=2
# Max posts in a single thread for one story
MAX_THREAD_POSTS=3
# Only consider stories published in the last N hours
MAX_NEWS_AGE_HOURS=12

# Optional: comma-separated list of tickers to prioritize in ranking
PRIORITY_TICKERS=AAPL,MSFT,NVDA,TSLA,AMZN,GOOGL,META

# Optional source policy controls by source-name substring match
# Example allowlist: Reuters,SEC
SOURCE_ALLOWLIST=
# Example denylist: Yahoo
SOURCE_DENYLIST=

# Respect robots.txt checks for article URLs
ENFORCE_ROBOTS_TXT=true

# Email delivery (digest with headline + 3-4 lines + link)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
# Comma-separated recipients
EMAIL_TO=
