# OpenAI (for summarization)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# X API credentials
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Bot behavior
# Set to true for testing without posting to X
DRY_RUN=true
# Number of posts per run
MAX_POSTS_PER_RUN=3
# Hours between runs (scheduler)
RUN_EVERY_HOURS=2
# Max posts in a single thread for one story
MAX_THREAD_POSTS=3

# Optional: comma-separated list of tickers to prioritize in ranking
PRIORITY_TICKERS=AAPL,MSFT,NVDA,TSLA,AMZN,GOOGL,META

# Optional source policy controls by source-name substring match
# Example allowlist: Reuters,SEC
SOURCE_ALLOWLIST=
# Example denylist: Yahoo
SOURCE_DENYLIST=

# Respect robots.txt checks for article URLs
ENFORCE_ROBOTS_TXT=true
